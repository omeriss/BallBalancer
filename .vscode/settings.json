    "stm32f1xx_hal_conf.h": "c",
    "stepper.h": "c",
    "stm32f1xx_hal_crc.h": "c",
    "stdbool.h": "c",
    "main.h": "c",
    "screen.h": "c",
    "bit": "c",
    "cmath": "c",
    "stm32h5xx_hal.h": "c",
    "stm32h5xx_hal_conf.h": "c",
    "stm32h5xx_hal_rcc.h": "c",
    "stm32h5xx_hal_def.h": "c",
    "stm32_hal_legacy.h": "c",
    "stm32h5xx.h": "c",
    "i2c.h": "c",
    "mpu6050.h": "c"
